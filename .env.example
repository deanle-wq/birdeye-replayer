# ── Birdeye Data API key ───────────────────────────────────────────────────
# Server-side only: never prefix it with NEXT_PUBLIC_. Get one at
# https://data.birdeye.so
# Visitors can also paste their own key in the app; theirs takes precedence.
# Leave this unset on a public deployment to make every visitor bring a key.
BIRDEYE_API_KEY=

# ── Protect a public deployment (recommended on Vercel) ─────────────────────
# A shared link can spend your compute units. Set a site-wide password
# (HTTP Basic auth, any username) for demos; leave unset to stay open.
# SITE_PASSWORD=

# Requests per minute per IP for the routes that spend compute units
# (/api/analyze and /api/replay; /api/ohlcv gets 3x). Counted per server
# instance, so treat it as a speed bump. 0 turns it off. Default 20.
# RATE_LIMIT_PER_MINUTE=20

# ── Birdeye client ──────────────────────────────────────────────────────────
# BIRDEYE_BASE_URL=https://public-api.birdeye.so
# Parallel requests per process.
# BIRDEYE_CONCURRENCY=12
# Retries on 429 and 5xx, with backoff.
# BIRDEYE_MAX_RETRIES=4
# BIRDEYE_TIMEOUT_MS=20000

# ── Ledger audit ────────────────────────────────────────────────────────────
# Wallets audited per /api/analyze call when the request does not say (max 20).
# The UI asks for the leading wallet only.
# AUDIT_WALLETS=8
# Balance-change or trade rows read per wallet before the ledger is marked
# truncated (which caps its confidence at low).
# AUDIT_MAX_EVENTS=10000
# Above this many Birdeye trades a wallet's video uses side-balanced sampling
# instead of a full ledger.
# AUDIT_MAX_TRADES=5000
# Top Traders rows per ranking lens (10 to 30). Six lenses are unioned.
# CANDIDATES_PER_LENS=10

# ── Video replay ────────────────────────────────────────────────────────────
# Wallets up to this many Birdeye trades get a full ledger in the video
# (about 40-60 s at the top end on busy tokens); heavier ones are sampled.
# REPLAY_MAX_TRADES=7500
# Row ceiling for that full read before it is marked truncated.
# REPLAY_MAX_EVENTS=25000

# ── Cache ───────────────────────────────────────────────────────────────────
# Successful Birdeye responses and analyses are cached in process for this
# long. Swap in Redis or Postgres before running several instances.
# CACHE_TTL_SECONDS=300
